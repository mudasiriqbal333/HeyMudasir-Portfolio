# Copy to .env.local for values that belong to one machine or must stay private.
# On the host (Vercel or similar) set them in the project's environment settings.

# The site's own address, with https:// and no trailing slash. Canonical links,
# the sitemap, robots.txt and the share image are built from it. Without it a
# build falls back to the Vercel preview address, and to http://localhost:3000
# on your own machine.
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# The contact form emails each message to the address on the contact page,
# through Resend (resend.com). With no domain verified on Resend it sends from
# onboarding@resend.dev, which only delivers to the email the Resend account
# was opened with, so open it with the contact page's address. Create an API
# key there and set it here and on the host. Keep it private. Reply in your
# inbox answers the person who wrote.
RESEND_API_KEY=
# Optional: another inbox, or, once a domain is verified on Resend, a sender
# on it such as "Portfolio contact form <contact@your-domain.com>".
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=

# Instead of email: any address that accepts a JSON POST (Formspree, Make,
# Zapier, n8n, your own API). Used only when RESEND_API_KEY is not set.
# Without either, the live form answers "Something went wrong".
CONTACT_WEBHOOK_URL=

# The Cloudinary account that hosts the My Friend media. Public (it is part of
# every image address) and already set in .env.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=dqbj2ip7c
