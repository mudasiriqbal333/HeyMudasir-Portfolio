# The site's own address (https://, no trailing slash). Canonical links, the
# sitemap, robots.txt and the share image are built from it, on every host.
# No domain yet: while this is unset, a Vercel build uses the project's
# *.vercel.app address and local dev uses http://localhost:3000. Once a domain
# is bought, uncomment and set it, e.g.:
# NEXT_PUBLIC_SITE_URL=https://your-domain.com

